@model WebApp.Models.AcceptTreatmentViewModel
@{
    ViewData["Title"] = "Xác nhận đặt lịch điều trị";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-check-circle me-2"></i>Xác nhận đặt lịch điều trị
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Booking Information -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h6 class="alert-heading">
                                    <i class="fas fa-info-circle me-2"></i>Thông tin đặt lịch
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Mã đặt lịch:</strong> #@Model.BookingId</p>
                                        <p class="mb-1"><strong>Khách hàng:</strong> @Model.UserName</p>
                                        <p class="mb-0"><strong>Dịch vụ:</strong> @Model.ServiceName</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Bác sĩ:</strong> @Model.DoctorName</p>
                                        <p class="mb-0"><strong>Ngày đặt:</strong> 
                                            @if (Model.BookingDate.HasValue)
                                            {
                                                @Model.BookingDate.Value.ToString("dd/MM/yyyy HH:mm")
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Accept Form -->
                    <form asp-action="Accept" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BookingId" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="ServiceName" />
                        <input type="hidden" asp-for="DoctorName" />
                        <input type="hidden" asp-for="BookingDate" />

                        <div class="alert alert-info">
                            <h6 class="alert-heading">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận đặt lịch điều trị
                            </h6>
                            <p class="mb-0">
                                Bạn có chắc chắn muốn xác nhận đặt lịch điều trị này không?
                                Sau khi xác nhận, khách hàng sẽ nhận được thông báo và có thể tiến hành điều trị.
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Quay lại
                            </a>
                            <div>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-check me-1"></i>Xác nhận đặt lịch
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Additional Information Card -->
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-lightbulb me-2"></i>Lưu ý khi xác nhận
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-primary">
                                <i class="fas fa-check-circle me-1"></i>Sau khi xác nhận:
                            </h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-envelope me-2 text-info"></i>Khách hàng sẽ nhận được thông báo</li>
                                <li><i class="fas fa-calendar-plus me-2 text-info"></i>Trạng thái chuyển thành "Đã xác nhận"</li>
                                <li><i class="fas fa-user-md me-2 text-info"></i>Bác sĩ có thể bắt đầu lập lịch điều trị</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-warning">
                                <i class="fas fa-exclamation-triangle me-1"></i>Cần lưu ý:
                            </h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-clock me-2 text-warning"></i>Kiểm tra lịch trống của bác sĩ</li>
                                <li><i class="fas fa-hospital me-2 text-warning"></i>Đảm bảo cơ sở vật chất sẵn sàng</li>
                                <li><i class="fas fa-phone me-2 text-warning"></i>Liên hệ khách hàng nếu cần thiết</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Form confirmation
            $('form').on('submit', function(e) {
                if (!confirm('Bạn có chắc chắn muốn xác nhận đặt lịch điều trị này không?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .alert-info {
            border-left: 4px solid #0dcaf0;
        }
        
        .card-header.bg-success {
            background-color: #198754 !important;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
        }
        
        .btn-success {
            background-color: #198754;
            border-color: #198754;
        }
        
        .btn-success:hover {
            background-color: #157347;
            border-color: #146c43;
        }
    </style>
}
