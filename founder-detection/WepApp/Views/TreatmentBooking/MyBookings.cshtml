@model IEnumerable<Model.Models.TreatmentBooking>
@{
    ViewData["Title"] = "Lịch điều trị của tôi";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>Lịch điều trị của tôi
                    </h4>
                    <a href="@Url.Action("BookTreatment")" class="btn btn-light">
                        <i class="fas fa-plus me-1"></i>Đặt lịch mới
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th><i class="fas fa-hashtag me-1"></i>Mã đặt lịch</th>
                                        <th><i class="fas fa-heartbeat me-1"></i>Dịch vụ</th>
                                        <th><i class="fas fa-user-md me-1"></i>Bác sĩ</th>
                                        <th><i class="fas fa-calendar me-1"></i>Ngày đặt</th>
                                        <th><i class="fas fa-info-circle me-1"></i>Trạng thái</th>
                                        <th><i class="fas fa-cogs me-1"></i>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary">#@booking.BookingId</span>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@(booking.Service?.Name ?? "N/A")</strong>
                                                    @if (!string.IsNullOrEmpty(booking.Service?.MethodType))
                                                    {
                                                        <br><small class="text-muted">@booking.Service.MethodType</small>
                                                    }
                                                    @if (booking.Service?.Price.HasValue == true)
                                                    {
                                                        <br><small class="text-success">@booking.Service.Price.Value.ToString("N0") VNĐ</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@(booking.Doctor?.User?.FullName ?? "N/A")</strong>
                                                    @if (!string.IsNullOrEmpty(booking.Doctor?.Specialization))
                                                    {
                                                        <br><small class="text-muted">@booking.Doctor.Specialization</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (booking.BookingDate.HasValue)
                                                {
                                                    <span>@booking.BookingDate.Value.ToString("dd/MM/yyyy")</span>
                                                    <br><small class="text-muted">@booking.BookingDate.Value.ToString("HH:mm")</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    var statusClass = booking.Status switch
                                                    {
                                                        "Chờ xác nhận" => "bg-warning text-dark",
                                                        "Đã xác nhận" => "bg-info text-white",
                                                        "Đang điều trị" => "bg-primary text-white",
                                                        "Hoàn thành" => "bg-success text-white",
                                                        "Đã hủy" => "bg-danger text-white",
                                                        _ => "bg-secondary text-white"
                                                    };
                                                }
                                                <span class="badge @statusClass">@(booking.Status ?? "N/A")</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @if (booking.Status == "Chờ xác nhận")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                                onclick="cancelBooking(@booking.BookingId)">
                                                            <i class="fas fa-times me-1"></i>Hủy
                                                        </button>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-info" 
                                                            onclick="viewDetails(@booking.BookingId)">
                                                        <i class="fas fa-eye me-1"></i>Chi tiết
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Bạn chưa có lịch điều trị nào</h5>
                            <p class="text-muted">Hãy đặt lịch điều trị đầu tiên của bạn</p>
                            <a href="@Url.Action("BookTreatment")" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Đặt lịch điều trị
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for booking details -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết đặt lịch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="bookingDetailsContent">
                <!-- Content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewDetails(bookingId) {
            // Show loading
            $('#bookingDetailsContent').html('<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>');
            $('#bookingDetailsModal').modal('show');
            
            // TODO: Load booking details via AJAX
            // For now, show a placeholder
            setTimeout(function() {
                $('#bookingDetailsContent').html('<p>Chi tiết đặt lịch #' + bookingId + ' sẽ được hiển thị ở đây.</p>');
            }, 500);
        }

        function cancelBooking(bookingId) {
            if (confirm('Bạn có chắc chắn muốn hủy lịch điều trị này?')) {
                // TODO: Implement cancel booking functionality
                alert('Chức năng hủy lịch sẽ được triển khai sau.');
            }
        }
    </script>
}
